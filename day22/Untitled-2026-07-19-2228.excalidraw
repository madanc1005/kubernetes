      "link": null,
      "locked": false,
      "text": "3-java-jenkins-docker-app\n\npipeline{\n    agent any\n    stages{\n        stage(\"git clone\"){\n            steps{\n                git branch: 'main', changelog: false, poll: false, url: 'https://github.com/theshubhamgour/jenkins-tutorial.git'\n                echo \"Git clone completed successfully\"\n            }\n        }\n        stage(\"build\"){\n            steps{\n                dir('3-java-jenkins-docker-app'){\n                    sh 'mvn clean package'\n                    echo \"Build completed successfully\"\n                }\n            }\n        }\n        stage(\"Test\"){\n            steps{\n                dir('3-java-jenkins-docker-app'){\n                    sh 'mvn test'\n                    echo \"Test completed successfully\"\n                }\n            }\n        }\n        stage(\"docker_build\"){\n            steps{\n                dir('3-java-jenkins-docker-app'){\n                    sh 'docker build -t java_jenkins_app:latest .'\n                }\n            }\n        }\n        stage(\"Docker_Run\"){\n            steps{\n                dir('3-java-jenkins-docker-app'){\n                    sh 'docker run --rm java_jenkins_app:latest'\n                }\n            }\n        }\n    }\n}\n\n\n\n\n\n",
      "fontSize": 33.17877570950254,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3-java-jenkins-docker-app\n\npipeline{\n    agent any\n    stages{\n        stage(\"git clone\"){\n            steps{\n                git branch: 'main', changelog: false, poll: false, url: 'https://github.com/theshubhamgour/jenkins-tutorial.git'\n                echo \"Git clone completed successfully\"\n            }\n        }\n        stage(\"build\"){\n            steps{\n                dir('3-java-jenkins-docker-app'){\n                    sh 'mvn clean package'\n                    echo \"Build completed successfully\"\n                }\n            }\n        }\n        stage(\"Test\"){\n            steps{\n                dir('3-java-jenkins-docker-app'){\n                    sh 'mvn test'\n                    echo \"Test completed successfully\"\n                }\n            }\n        }\n        stage(\"docker_build\"){\n            steps{\n                dir('3-java-jenkins-docker-app'){\n                    sh 'docker build -t java_jenkins_app:latest .'\n                }\n            }\n        }\n        stage(\"Docker_Run\"){\n            steps{\n                dir('3-java-jenkins-docker-app'){\n                    sh 'docker run --rm java_jenkins_app:latest'\n                }\n            }\n        }\n    }\n}\n\n\n\n\n\n",
      "autoResize": true,

      "text": "#deployment.yaml\napiVersion: apps/v1 \nkind: Deployment \nmetadata: \n  name: enginex-deployment \nspec: \n  replicas: 1 \n  selector:\n    matchLabels: \n      app: enginex \n  template: \n    metadata:\n      labels:\n        app: enginex \n    spec: \n      containers: \n      - name: enginex \n        image: nginx:1.21 \n        ports: \n        - containerPort: 80 \n        resources: \n          requests: \n            memory: \"128Mi\" \n            cpu: \"100m\" \n          limits: \n            memory: \"256Mi\" \n            cpu: \"250m\" \n        volumeMounts: \n          - name: config-volume \n            mountPath: /usr/share/nginx/html \n      volumes: \n      - name: config-volume \n        configMap: \n          name: enginex-config",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,

    {
      "id": "f7MMju4sQsHg9qzonrYwb",
      "type": "text",
      "x": 141.39963330197986,
      "y": 20342.023231980416,
      "width": 1542,
      "height": 630,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 534758998,
      "version": 91,
      "versionNonce": 954449098,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783528174152,
      "link": null,
      "locked": false,
      "text": "Create topic\n/opt/kafka/bin/kafka-topics.sh --create --topic obito --bootstrap-server localhost:9092\n\n\nDelete topic\n/opt/kafka/bin/kafka-topics.sh --delete --topic obito  --bootstrap-server localhost:9092\n\n\nView list of topics\n/opt/kafka/bin/kafka-topics.sh  --list  --bootstrap-server localhost:9092\n\n\nverify topic details\n/opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --describe --topic obito \n\n\ncreate topic with 2 partitions\n/opt/kafka/bin/kafka-topics.sh --create --topic obito --bootstrap-server localhost:9092 --partitions 2 --replication-factor 1",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Create topic\n/opt/kafka/bin/kafka-topics.sh --create --topic obito --bootstrap-server localhost:9092\n\n\nDelete topic\n/opt/kafka/bin/kafka-topics.sh --delete --topic obito  --bootstrap-server localhost:9092\n\n\nView list of topics\n/opt/kafka/bin/kafka-topics.sh  --list  --bootstrap-server localhost:9092\n\n\nverify topic details\n/opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --describe --topic obito \n\n\ncreate topic with 2 partitions\n/opt/kafka/bin/kafka-topics.sh --create --topic obito --bootstrap-server localhost:9092 --partitions 2 --replication-factor 1",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },

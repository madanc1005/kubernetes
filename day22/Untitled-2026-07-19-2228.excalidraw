    {
      "id": "eTAv7bONNmd0VkXxPq3jj",
      "type": "text",
      "x": 91.48218570036431,
      "y": 21743.401041324356,
      "width": 706,
      "height": 525,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 294168842,
      "version": 56,
      "versionNonce": 1324964362,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783529929205,
      "link": null,
      "locked": false,
      "text": "1) What Kafka expects from you\n\n        Because you enabled:\n\n                --property \"parse.key=true\"\n\n                Kafka expects each line you type in this format:\n                key:value\n\n                So if you type:\n                user1:hello\n\n                Kafka splits it into 2 parts:\n                key = user1\n                value = hello",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) What Kafka expects from you\n\n        Because you enabled:\n\n                --property \"parse.key=true\"\n\n                Kafka expects each line you type in this format:\n                key:value\n\n                So if you type:\n                user1:hello\n\n                Kafka splits it into 2 parts:\n                key = user1\n                value = hello",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "Qcn_V_8H8I4OQ_tEOQACO",
      "type": "rectangle",
      "x": 85.93581438776607,
      "y": 21723.92535599331,
      "width": 735.8157731184224,
      "height": 565.7278110144289,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",

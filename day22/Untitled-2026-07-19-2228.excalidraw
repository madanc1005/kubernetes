    {
      "id": "vVBmMmzrZuR7moypIG_mG",
      "type": "text",
      "x": 940.9967880902198,
      "y": 21763.838466584468,
      "width": 426,
      "height": 455,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 1874037078,
      "version": 86,
      "versionNonce": 1538250826,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783530023988,
      "link": null,
      "locked": false,
      "text": "2) How splitting happens\n\n        Because you also gave:\n\n        --property \"key.separator=:\"\n        Kafka uses : as the separator.\n        So it reads:\n        user1:hello\n\n        and cuts it like this:\n        user1 | hello\n         ^       ^\n         key    value",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) How splitting happens\n\n        Because you also gave:\n\n        --property \"key.separator=:\"\n        Kafka uses : as the separator.\n        So it reads:\n        user1:hello\n\n        and cuts it like this:\n        user1 | hello\n         ^       ^\n         key    value",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },

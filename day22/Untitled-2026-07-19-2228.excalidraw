      "seed": 770244694,
      "version": 245,
      "versionNonce": 1278431946,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783530718239,
      "link": null,
      "locked": false,
      "text": "\nlogin as a consumer to send the message\n/opt/kafka/bin/kafka-console-producer.sh --topic obito --bootstrap-server localhost:9092\n\n\n/opt/kafka/bin/kafka-console-producer.sh --topic obito2 --bootstrap-server localhost:9092 --reader-property \"parse.key=true\" --reader-property \"key.separator=:\"\n\n\n",
      "fontSize": 30.773175077475397,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nlogin as a consumer to send the message\n/opt/kafka/bin/kafka-console-producer.sh --topic obito --bootstrap-server localhost:9092\n\n\n/opt/kafka/bin/kafka-console-producer.sh --topic obito2 --bootstrap-server localhost:9092 --reader-property \"parse.key=true\" --reader-property \"key.separator=:\"\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },

    {
      "id": "qrxzikCNhoDXmEc8QUUWE",
      "type": "text",
      "x": 85.93592017599985,
      "y": 21412.46878720208,
      "width": 2267,
      "height": 346.1982196215982,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
